# Settings shared by every task. Task-specific settings are in tasks/<task>/task.env.

CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=medium
AGENT_BUDGET_USD=15
INPUT_USD_PER_MILLION=0.10
CACHED_INPUT_USD_PER_MILLION=0.01
OUTPUT_USD_PER_MILLION=0.50

# 4 agents per arm, all started together, 15 minutes each, each on 1 pinned core with 1 GB.
AGENT_COUNT=4
MAX_RUNTIME_SECONDS=900
AGENT_CPUS=1
AGENT_MEMORY=1g
# The last cores of the Docker VM stay free for the proxies.
RESERVED_CPUS=2

# Collaborative agents that read the platform; the other collaborative agents publish but never read.
EXPERIMENT_PLATFORM_SLOTS="3 4"
